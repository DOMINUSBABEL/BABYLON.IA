# BABYLON.IA Environment Configuration

# Core
GEMINI_MODEL=gemini-3.1-pro-preview
ENABLED_PLATFORMS=whatsapp,web,telegram,twitter,github,discord,wechat
ENVIRONMENT=desktop # Use 'mobile_terminal' for Termux (Android) low-RAM mode

# Hermes Architecture (Message Broker)
REDIS_URL=redis://127.0.0.1:6379 # Omitir para fallback a EventEmitter local

# Security
AUTHORIZED_NUMBERS=573000000000,573110000000

# GitHub Integration
GITHUB_TOKEN=your_personal_access_token_or_app_token
GITHUB_WEBHOOK_SECRET=your_webhook_secret_for_validation
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY=

# Telegram Integration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# Discord Integration
DISCORD_TOKEN=your_discord_bot_token

# Twitter Integration
TWITTER_BEARER_TOKEN=your_twitter_bearer_token
