# BABYLON.IA Environment Configuration

# Core
GEMINI_MODEL=gemini-3.1-pro-preview
ENABLED_PLATFORMS=whatsapp,web,telegram,twitter,github,discord,wechat,openwa
ENVIRONMENT=desktop # Use 'mobile_terminal' for Termux (Android) low-RAM mode

# OpenWA Integration
OPENWA_API_URL=http://localhost:2785
OPENWA_API_KEY=your_openwa_api_key
OPENWA_SESSION_ID=default
PUBLIC_URL=https://your-public-ngrok-or-domain.com # Requerido para registrar webhooks automáticamente

# Security
AUTHORIZED_NUMBERS=573000000000,573110000000

# GitHub Integration
GITHUB_TOKEN=your_personal_access_token_or_app_token
GITHUB_WEBHOOK_SECRET=your_webhook_secret_for_validation
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY=

# Telegram Integration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# Discord Integration
DISCORD_TOKEN=your_discord_bot_token

# Twitter Integration
TWITTER_BEARER_TOKEN=your_twitter_bearer_token
